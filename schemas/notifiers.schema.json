{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NotifiersFile",
  "$defs": {
    "FeishuApp": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "secretRef": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "feishu",
            "lark"
          ]
        },
        "proxy": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "appId",
        "secretRef",
        "domain"
      ]
    },
    "Notifier": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "feishu_app"
          ]
        },
        "app": {
          "type": "string",
          "minLength": 1
        },
        "chatId": {
          "type": "string",
          "minLength": 1
        },
        "chatName": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "app",
        "chatId"
      ]
    },
    "NotifiersFile": {
      "properties": {
        "feishuApps": {
          "items": {
            "$ref": "#/$defs/FeishuApp"
          },
          "type": "array"
        },
        "notifiers": {
          "items": {
            "$ref": "#/$defs/Notifier"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
