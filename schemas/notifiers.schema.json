{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NotifiersFile",
  "$defs": {
    "FeishuApp": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "secretRef": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "feishu",
            "lark"
          ]
        },
        "proxy": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "appId",
        "secretRef",
        "domain"
      ]
    },
    "Notifier": {
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "feishu_app"
              }
            }
          },
          "then": {
            "required": [
              "app",
              "chatId"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "feishu_webhook"
              }
            }
          },
          "then": {
            "required": [
              "urlRef"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "required": [
              "urlRef"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "toast"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "app"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "toast"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "chatId"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "toast"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "chatName"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "toast"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "template"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "feishu_webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "app"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "app"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "feishu_webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "chatId"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "chatId"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "feishu_webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "chatName"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "chatName"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "template"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "feishu_app"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "urlRef"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "feishu_app"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "secretRef"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "toast"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "urlRef"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "toast"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "secretRef"
              ]
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "feishu_app",
            "feishu_webhook",
            "webhook",
            "toast"
          ]
        },
        "app": {
          "type": "string",
          "minLength": 1
        },
        "chatId": {
          "type": "string",
          "minLength": 1
        },
        "chatName": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "urlRef": {
          "not": {
            "pattern": "://"
          },
          "type": "string",
          "minLength": 1,
          "description": "Webhook 地址在密钥库中的引用，不能填写明文地址。"
        },
        "secretRef": {
          "not": {
            "pattern": "://"
          },
          "type": "string",
          "minLength": 1,
          "description": "可选签名密钥的引用，不是密钥内容。"
        },
        "filter": {
          "$ref": "#/$defs/NotifierFilter"
        },
        "cardActions": {
          "type": "boolean",
          "description": "仅飞书应用：管理员明确授权该群成员确认消息对应告警或静音该告警组一小时，默认关闭。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type"
      ]
    },
    "NotifierFilter": {
      "properties": {
        "severity": {
          "items": {
            "type": "string",
            "enum": [
              "critical",
              "warning",
              "info"
            ]
          },
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "tags": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "collectors": {
          "items": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^\\s*/\\\\:]+$"
          },
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "NotifiersFile": {
      "properties": {
        "feishuApps": {
          "items": {
            "$ref": "#/$defs/FeishuApp"
          },
          "type": "array"
        },
        "notifiers": {
          "items": {
            "$ref": "#/$defs/Notifier"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
