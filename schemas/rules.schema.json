{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RulesFile",
  "$defs": {
    "Duration": {
      "type": "string",
      "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h|d))+)$"
    },
    "Rule": {
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "collector_offline"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "target"
              ]
            }
          },
          "else": {
            "if": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "sql"
                      }
                    }
                  },
                  {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "metric_threshold"
                      }
                    }
                  }
                ]
              }
            },
            "then": {
              "required": [
                "target"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "metric_threshold"
              }
            }
          },
          "then": {
            "required": [
              "metric",
              "op",
              "threshold"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "sql"
              }
            }
          },
          "then": {
            "required": [
              "query"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "cert_expiry"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "for"
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "cert_expiry"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "within"
              ]
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "process_absent",
            "port_closed",
            "probe_failed",
            "collector_offline",
            "metric_threshold",
            "service_stopped",
            "script_failed",
            "sql",
            "cert_expiry"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "for": {
          "$ref": "#/$defs/Duration"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "warning",
            "info"
          ]
        },
        "notify": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "template": {
          "type": "string"
        },
        "renotify": {
          "$ref": "#/$defs/Duration"
        },
        "metric": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "ne"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "resource": {
          "type": "string"
        },
        "probe": {
          "type": "integer",
          "minimum": 0
        },
        "query": {
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/Duration"
        },
        "within": {
          "$ref": "#/$defs/Duration",
          "description": "cert_expiry 的剩余时长阈值，默认 14d，范围 1h～365d。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "severity",
        "notify"
      ]
    },
    "RulesFile": {
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
