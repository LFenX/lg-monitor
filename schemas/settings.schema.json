{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Settings",
  "$defs": {
    "CacheSettings": {
      "properties": {
        "maxSize": {
          "type": "string",
          "pattern": "^[0-9]+(B|KB|MB|GB)$",
          "description": "采集器本机离线缓存物理上限，默认 500MB，范围 64MB～10GB；单位为十进制，不随目标下发。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Duration": {
      "type": "string",
      "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h|d))+)$"
    },
    "Retention": {
      "properties": {
        "raw": {
          "$ref": "#/$defs/Duration",
          "description": "原始数据保留时长，默认 24h。"
        },
        "minute": {
          "$ref": "#/$defs/Duration",
          "description": "分钟汇总保留时长，默认 336h（14 天）。"
        },
        "hour": {
          "$ref": "#/$defs/Duration",
          "description": "小时汇总保留时长，默认 8760h（365 天）。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Settings": {
      "properties": {
        "cache": {
          "$ref": "#/$defs/CacheSettings"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "httpListen": {
          "type": "string",
          "description": "HTTP API 监听地址，默认 127.0.0.1:7444。"
        },
        "publicBaseUrl": {
          "type": "string",
          "format": "uri",
          "description": "卡片打开面板按钮使用的 HTTP/HTTPS 基础地址。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
