{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Settings",
  "$defs": {
    "AssistantSettings": {
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 200,
          "description": "DeepSeek 对话模型，省略时用 deepseek-chat；可用的模型以 DeepSeek 账号里列出的为准。"
        },
        "region": {
          "type": "string",
          "enum": [
            "beijing",
            "singapore"
          ],
          "description": "百炼地域：beijing（默认，国内）或 singapore（国际）。"
        },
        "embeddingModel": {
          "type": "string",
          "maxLength": 200,
          "description": "百炼向量模型，省略时用 qwen3.7-text-embedding。"
        },
        "rerankModel": {
          "type": "string",
          "maxLength": 200,
          "description": "百炼 rerank 模型，省略时用 qwen3.7-text-rerank。"
        },
        "provider": {
          "type": "string",
          "description": "旧版字段，已不再使用：现在对话固定用 DeepSeek。"
        },
        "baseUrl": {
          "type": "string",
          "description": "旧版字段，已不再使用。"
        },
        "keyRef": {
          "type": "string",
          "description": "旧版字段，已不再使用。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CacheSettings": {
      "properties": {
        "maxSize": {
          "type": "string",
          "pattern": "^[0-9]+(B|KB|MB|GB)$",
          "description": "采集器本机离线缓存物理上限，默认 500MB，范围 64MB～10GB；单位为十进制，不随目标下发。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CollectionSettings": {
      "properties": {
        "targetInterval": {
          "$ref": "#/$defs/Duration",
          "description": "本机目标采集周期，默认 2s，500ms～5s，整毫秒；重启采集器生效。"
        },
        "processInterval": {
          "$ref": "#/$defs/Duration",
          "description": "完整进程查询缓存的独立刷新周期，默认 15s，1s～1m，整毫秒；目标/ETW 新事实也更新缓存，重启生效。"
        },
        "systemInterval": {
          "$ref": "#/$defs/Duration",
          "description": "系统指标周期，默认 5s，1s～1m，整毫秒；重启采集器生效。"
        },
        "serviceInterval": {
          "$ref": "#/$defs/Duration",
          "description": "Windows 服务全表周期，默认 10s，1s～1m，整毫秒；重启采集器生效。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CollectorMonitor": {
      "properties": {
        "id": {
          "not": {
            "pattern": "^(default|con|prn|aux|nul|com[1-9]|lpt[1-9])$"
          },
          "type": "string",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "enabled": {
          "type": "boolean",
          "description": "省略为 true；重启采集器生效。"
        },
        "allowOperations": {
          "type": "boolean",
          "description": "默认 false；仍须满足本机 remoteOperations 和受保护 LocalSystem 授权，重启生效。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id"
      ]
    },
    "Duration": {
      "type": "string",
      "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h|d))+)$"
    },
    "ExportSettings": {
      "properties": {
        "prometheus": {
          "$ref": "#/$defs/PrometheusSettings"
        },
        "otlp": {
          "$ref": "#/$defs/OTLPSettings"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ExportTLS": {
      "properties": {
        "caRef": {
          "type": "string",
          "maxLength": 256,
          "description": "可选 PEM 根证书的加密密钥引用，追加到系统可信根。"
        },
        "certRef": {
          "type": "string",
          "maxLength": 256,
          "description": "可选 mTLS 客户端 PEM 证书引用，与 keyRef 成对。"
        },
        "keyRef": {
          "type": "string",
          "maxLength": 256,
          "description": "可选 mTLS 客户端私钥引用，与 certRef 成对。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "InventorySettings": {
      "properties": {
        "interval": {
          "$ref": "#/$defs/Duration",
          "description": "本机启动项和计划任务采集间隔，默认 1m，10s～1h，重启采集器生效。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "LANSettings": {
      "properties": {
        "visible": {
          "type": "boolean",
          "description": "打开后回应局域网发现，并在成员端口公开面板名称和简介；默认关闭。"
        },
        "web": {
          "type": "boolean",
          "description": "打开后允许同一局域网或 Tailscale 的设备通过浏览器只读访问本监控看板，并支持只读使用波西米亚；默认关闭。"
        },
        "webBoards": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "允许内网浏览器只读访客查看的面板 ID 列表；留空表示允许查看全部面板。"
        },
        "webServices": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object",
          "description": "按面板指定访客可查看的服务和子服务 ID；没有条目表示整块面板，空列表表示该面板不开放任何服务。"
        },
        "webDeviceBoards": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object",
          "description": "同一云账号下其他设备开放给内网浏览器访客的面板：设备 ID 对应面板 ID 列表；没有条目表示该设备的面板都不开放。"
        },
        "name": {
          "type": "string",
          "maxLength": 40,
          "description": "别人在内网里看到的名字，省略时用电脑名。"
        },
        "departments": {
          "type": "boolean",
          "description": "这台电脑托管着部门时为 true：即使不打开内网可见，也在局域网回应发现并提供部门信息（面板仍然不公开）。由 lgmon 在创建或删除部门时设置。"
        },
        "peers": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 32,
          "description": "广播到不了的内网电脑（例如在另一个网段）的 IP 或主机名：每次发现都会直接问这些地址，找到它们的部门和面板。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OTLPSettings": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "启用监控器 OTLP/HTTP protobuf 指标推送，默认关闭。"
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2048,
          "description": "完整指标接收 URL，例如 http://127.0.0.1:4318/v1/metrics；远端必须 HTTPS，不允许用户信息、查询或片段。"
        },
        "interval": {
          "$ref": "#/$defs/Duration",
          "description": "推送周期，默认 30s，范围 10s～1h。"
        },
        "timeout": {
          "$ref": "#/$defs/Duration",
          "description": "整个导出周期预算，默认 10s，范围 1s～30s。"
        },
        "authorizationRef": {
          "type": "string",
          "maxLength": 256,
          "description": "密钥库中完整 Authorization 请求头的引用，不填写凭据正文。"
        },
        "tls": {
          "$ref": "#/$defs/ExportTLS"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ProcessEventsSettings": {
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "",
            "auto",
            "disabled"
          ],
          "description": "本机即时进程事件：auto 使用自有 ETW 会话，disabled 使用原间隔采样；省略或空值为 auto，重启采集器生效。",
          "default": "auto"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PrometheusSettings": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "启用带 read 鉴权的 GET /metrics，默认关闭。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RemoteOperations": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "本机管理员授权开关，默认 false；不能通过 HTTP/MCP 或目标下发修改。"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceGrant"
          },
          "type": "array",
          "maxItems": 128
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Retention": {
      "properties": {
        "raw": {
          "$ref": "#/$defs/Duration",
          "description": "原始数据保留时长，默认 24h。"
        },
        "minute": {
          "$ref": "#/$defs/Duration",
          "description": "分钟汇总保留时长，默认 336h（14 天）。"
        },
        "hour": {
          "$ref": "#/$defs/Duration",
          "description": "小时汇总保留时长，默认 8760h（365 天）。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ServiceGrant": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "service": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "description": "精确 Windows SCM 服务名，仅授权无参数 restart_service；不能用路径、通配符、显示名称或命令。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "service"
      ]
    },
    "ServiceSwitchSettings": {
      "properties": {
        "path": {
          "type": "string",
          "description": "仅本机设置的 services.json Windows 绝对路径，不经 HTTP 修改或下发；重启采集器生效。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Settings": {
      "properties": {
        "assistant": {
          "$ref": "#/$defs/AssistantSettings"
        },
        "collection": {
          "$ref": "#/$defs/CollectionSettings"
        },
        "collectorMonitors": {
          "items": {
            "$ref": "#/$defs/CollectorMonitor"
          },
          "type": "array",
          "maxItems": 7,
          "description": "本机附加监控器，HTTP/MCP 只读，最多 7 项；每个独立使用 cache.maxSize，修改后重启采集器生效。证书先通过 pair join --name 配对。"
        },
        "exports": {
          "$ref": "#/$defs/ExportSettings"
        },
        "processEvents": {
          "$ref": "#/$defs/ProcessEventsSettings"
        },
        "remoteOperations": {
          "$ref": "#/$defs/RemoteOperations"
        },
        "inventory": {
          "$ref": "#/$defs/InventorySettings"
        },
        "localAccess": {
          "type": "string",
          "enum": [
            "read",
            "config"
          ],
          "description": "在这台电脑上直接打开网页时的权限。read 只能查看；config 可以在网页里添加服务、建面板、确认告警。省略时：以本人身份运行（个人目录）为 config，以系统服务运行为 read。修改设置和密钥始终需要管理员令牌。"
        },
        "serviceSwitch": {
          "$ref": "#/$defs/ServiceSwitchSettings"
        },
        "cache": {
          "$ref": "#/$defs/CacheSettings"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "httpListen": {
          "type": "string",
          "description": "HTTP API 监听地址，默认 127.0.0.1:7444。"
        },
        "publicBaseUrl": {
          "type": "string",
          "format": "uri",
          "description": "卡片打开面板按钮使用的 HTTP/HTTPS 基础地址。"
        },
        "lan": {
          "$ref": "#/$defs/LANSettings",
          "description": "内网可见：打开后同一局域网的 lgmon 能看到面板名称和简介，看具体状态需要申请并经本人同意。"
        },
        "teamListen": {
          "type": "string",
          "description": "仅有自建团队时监听成员 HTTPS，默认 127.0.0.1:7445。"
        },
        "teamPublicUrl": {
          "type": "string",
          "format": "uri",
          "description": "邀请中的成员 HTTPS 基础地址；省略时用实际团队监听地址。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
