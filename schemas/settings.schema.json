{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Settings",
  "$defs": {
    "CacheSettings": {
      "properties": {
        "maxSize": {
          "type": "string",
          "pattern": "^[0-9]+(B|KB|MB|GB)$",
          "description": "采集器本机离线缓存物理上限，默认 500MB，范围 64MB～10GB；单位为十进制，不随目标下发。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Duration": {
      "type": "string",
      "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h|d))+)$"
    },
    "ExportSettings": {
      "properties": {
        "prometheus": {
          "$ref": "#/$defs/PrometheusSettings"
        },
        "otlp": {
          "$ref": "#/$defs/OTLPSettings"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ExportTLS": {
      "properties": {
        "caRef": {
          "type": "string",
          "maxLength": 256,
          "description": "可选 PEM 根证书的加密密钥引用，追加到系统可信根。"
        },
        "certRef": {
          "type": "string",
          "maxLength": 256,
          "description": "可选 mTLS 客户端 PEM 证书引用，与 keyRef 成对。"
        },
        "keyRef": {
          "type": "string",
          "maxLength": 256,
          "description": "可选 mTLS 客户端私钥引用，与 certRef 成对。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "InventorySettings": {
      "properties": {
        "interval": {
          "$ref": "#/$defs/Duration",
          "description": "本机启动项和计划任务采集间隔，默认 1m，10s～1h，重启采集器生效。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OTLPSettings": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "启用监控器 OTLP/HTTP protobuf 指标推送，默认关闭。"
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2048,
          "description": "完整指标接收 URL，例如 http://127.0.0.1:4318/v1/metrics；远端必须 HTTPS，不允许用户信息、查询或片段。"
        },
        "interval": {
          "$ref": "#/$defs/Duration",
          "description": "推送周期，默认 30s，范围 10s～1h。"
        },
        "timeout": {
          "$ref": "#/$defs/Duration",
          "description": "整个导出周期预算，默认 10s，范围 1s～30s。"
        },
        "authorizationRef": {
          "type": "string",
          "maxLength": 256,
          "description": "密钥库中完整 Authorization 请求头的引用，不填写凭据正文。"
        },
        "tls": {
          "$ref": "#/$defs/ExportTLS"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ProcessEventsSettings": {
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "",
            "auto",
            "disabled"
          ],
          "description": "本机即时进程事件：auto 使用自有 ETW 会话，disabled 使用原间隔采样；省略或空值为 auto，重启采集器生效。",
          "default": "auto"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PrometheusSettings": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "启用带 read 鉴权的 GET /metrics，默认关闭。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RemoteOperations": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "本机管理员授权开关，默认 false；不能通过 HTTP/MCP 或目标下发修改。"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceGrant"
          },
          "type": "array",
          "maxItems": 128
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Retention": {
      "properties": {
        "raw": {
          "$ref": "#/$defs/Duration",
          "description": "原始数据保留时长，默认 24h。"
        },
        "minute": {
          "$ref": "#/$defs/Duration",
          "description": "分钟汇总保留时长，默认 336h（14 天）。"
        },
        "hour": {
          "$ref": "#/$defs/Duration",
          "description": "小时汇总保留时长，默认 8760h（365 天）。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ServiceGrant": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "service": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "description": "精确 Windows SCM 服务名，仅授权无参数 restart_service；不能用路径、通配符、显示名称或命令。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "service"
      ]
    },
    "ServiceSwitchSettings": {
      "properties": {
        "path": {
          "type": "string",
          "description": "仅本机设置的 services.json Windows 绝对路径，不经 HTTP 修改或下发；重启采集器生效。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Settings": {
      "properties": {
        "exports": {
          "$ref": "#/$defs/ExportSettings"
        },
        "processEvents": {
          "$ref": "#/$defs/ProcessEventsSettings"
        },
        "remoteOperations": {
          "$ref": "#/$defs/RemoteOperations"
        },
        "inventory": {
          "$ref": "#/$defs/InventorySettings"
        },
        "serviceSwitch": {
          "$ref": "#/$defs/ServiceSwitchSettings"
        },
        "cache": {
          "$ref": "#/$defs/CacheSettings"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "httpListen": {
          "type": "string",
          "description": "HTTP API 监听地址，默认 127.0.0.1:7444。"
        },
        "publicBaseUrl": {
          "type": "string",
          "format": "uri",
          "description": "卡片打开面板按钮使用的 HTTP/HTTPS 基础地址。"
        },
        "teamListen": {
          "type": "string",
          "description": "仅有自建团队时监听成员 HTTPS，默认 127.0.0.1:7445。"
        },
        "teamPublicUrl": {
          "type": "string",
          "format": "uri",
          "description": "邀请中的成员 HTTPS 基础地址；省略时用实际团队监听地址。"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
