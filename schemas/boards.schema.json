{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BoardsFile",
  "$defs": {
    "Board": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1,
          "description": "面板名称，例如“我的服务”。"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "一句话介绍；打开内网可见时，局域网里的人能看到名称和这句介绍。"
        },
        "monitors": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true,
          "description": "面板上的监控目标 ID，按显示顺序。子服务随父服务显示，不必列出。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "BoardsFile": {
      "properties": {
        "boards": {
          "items": {
            "$ref": "#/$defs/Board"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
