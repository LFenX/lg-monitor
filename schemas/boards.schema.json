{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BoardsFile",
  "$defs": {
    "Board": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1,
          "description": "面板名称，例如“我的服务”。"
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "一句话介绍；打开内网可见时，局域网里的人能看到名称和这句介绍。"
        },
        "monitors": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true,
          "description": "面板上的监控目标 ID，按显示顺序。子服务随父服务显示，不必列出。"
        },
        "cardStyle": {
          "type": "string",
          "enum": [
            "pulse",
            "minimal",
            "ring",
            "latency",
            "days",
            "number"
          ],
          "description": "卡片视图里服务的默认样式：pulse 心跳（默认）、minimal 极简、ring 可用率环、latency 响应曲线、days 30 天、number 大数字。"
        },
        "cards": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "单独指定某些服务的卡片样式：服务 ID → 样式，取值同 cardStyle。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "BoardsFile": {
      "properties": {
        "boards": {
          "items": {
            "$ref": "#/$defs/Board"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
