{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TargetsFile",
  "$defs": {
    "Dependency": {
      "properties": {
        "target": {
          "type": "string",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "description": "被依赖的服务 ID。"
        },
        "relation": {
          "type": "string",
          "enum": [
            "uses",
            "calls",
            "data",
            "via",
            "runs",
            "sends"
          ],
          "description": "uses 依赖（默认）、calls 调用它的接口、data 读写它的数据、via 经由它对外（隧道、网关、代理）、runs 由它启动或触发、sends 向它发送消息。"
        },
        "note": {
          "type": "string",
          "maxLength": 80,
          "description": "一句补充，例如“订单表”“每天 01:00”。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "target"
      ]
    },
    "Duration": {
      "type": "string",
      "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h|d))+)$"
    },
    "EventLogSubscription": {
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "Application",
            "System"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "levels": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "channel",
        "provider"
      ]
    },
    "Match": {
      "allOf": [
        {
          "if": {
            "required": [
              "workDir"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "process"
                ]
              },
              {
                "required": [
                  "cmdline"
                ]
              },
              {
                "required": [
                  "exeDir"
                ]
              }
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "process"
          ]
        },
        {
          "required": [
            "cmdline"
          ]
        },
        {
          "required": [
            "port"
          ]
        },
        {
          "required": [
            "service"
          ]
        },
        {
          "required": [
            "exeDir"
          ]
        },
        {
          "required": [
            "workDir"
          ]
        }
      ],
      "properties": {
        "process": {
          "type": "string",
          "minLength": 1
        },
        "cmdline": {
          "type": "string",
          "minLength": 1,
          "description": "命令行正则默认不区分大小写；可用 (?-i) 显式区分大小写。"
        },
        "exeDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]{2}[^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+[\\\\/][^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+(?:[\\\\/]|$))[^:*?\"\u003c\u003e|\\x00-\\x1f]*$",
          "description": "程序所在目录，Windows 绝对盘符或 UNC 路径；匹配自身及子目录，不区分大小写。"
        },
        "workDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]{2}[^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+[\\\\/][^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+(?:[\\\\/]|$))[^:*?\"\u003c\u003e|\\x00-\\x1f]*$",
          "description": "当前工作目录，需同时配置 process、cmdline 或 exeDir；只对候选读取，十秒内复用缓存。"
        },
        "port": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Probe": {
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tcp"
              }
            }
          },
          "then": {
            "required": [
              "address"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ]
          }
        },
        {
          "if": {
            "required": [
              "keywordAbsent"
            ]
          },
          "then": {
            "required": [
              "keyword"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "http"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "keyword"
                  ]
                },
                {
                  "required": [
                    "keywordAbsent"
                  ]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "http",
            "tcp",
            "script"
          ]
        },
        "script": {
          "not": {
            "pattern": "[.][.]"
          },
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:\u003c\u003e\"|?*%\u0026^!()\\x00-\\x1F\\x7F]+\\.(?:[pP][sS]1|[cC][mM][dD]|[bB][aA][tT]|[eE][xX][eE])$"
        },
        "args": {
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 _.,:=/@+-]*$"
          },
          "type": "array"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "$ref": "#/$defs/Duration"
        },
        "timeout": {
          "$ref": "#/$defs/Duration"
        },
        "expectStatus": {
          "$ref": "#/$defs/Status"
        },
        "keyword": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "description": "区分大小写的 UTF-8 子串，1～256 字节；只检查解压正文的前 1 MiB。",
          "x-maxUtf8Bytes": 256
        },
        "keywordAbsent": {
          "type": "boolean",
          "description": "为 true 时要求关键字不出现；必须同时配置 keyword，仅限 HTTP。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "interval",
        "timeout"
      ]
    },
    "Status": {
      "oneOf": [
        {
          "type": "integer",
          "maximum": 599,
          "minimum": 100
        },
        {
          "type": "string",
          "pattern": "^([1-5][0-9]{2}|[1-5]xx|[\u003c\u003e]=?[1-5][0-9]{2})$"
        }
      ]
    },
    "Target": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "collector": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^(\\*|[^\\s*/\\\\:]+)$",
          "description": "采集器 ID 或主机名；* 或省略表示全部采集器，主机名不区分大小写。"
        },
        "match": {
          "$ref": "#/$defs/Match"
        },
        "eventlog": {
          "$ref": "#/$defs/EventLogSubscription"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/Probe"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/TargetSource"
        },
        "parent": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9-]+$",
          "description": "主服务的目标 ID。子服务（例如网站的 Tunnel）异常时，主服务整体算异常。只在监控器使用，不下发采集器。"
        },
        "task": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 2,
          "pattern": "^\\\\",
          "description": "Windows 计划任务的完整路径，例如 \\Backup\\Nightly。状态取自采集器的计划任务清单（上次运行结果、是否禁用）；只在监控器使用，不下发采集器。"
        },
        "role": {
          "type": "string",
          "enum": [
            "web",
            "api",
            "app",
            "database",
            "cache",
            "queue",
            "storage",
            "tunnel",
            "gateway",
            "worker",
            "scheduler",
            "ai",
            "mcp",
            "external"
          ],
          "description": "服务角色，决定依赖关系图里的图标：web 网站、api 接口、app 应用、database 数据库、cache 缓存、queue 消息队列、storage 文件与存储、tunnel 隧道、gateway 网关与代理、worker 后台程序、scheduler 定时任务、ai 模型服务、mcp MCP 服务、external 外部服务。省略时按监控类型推断。"
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "一两句话说明这个服务是做什么的、谁在用；显示在列表和详情里。"
        },
        "depends": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "type": "array",
          "maxItems": 20,
          "description": "这个服务用到的其他服务（可以跨面板）。只用于展示依赖关系，不影响告警；父子关系另用 parent。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id"
      ]
    },
    "TargetSource": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service-switch"
          ]
        },
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "maxLength": 47,
          "pattern": "^((app:|tunnel:)[a-z0-9][a-z0-9-]*|database)$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "collector",
        "ref"
      ]
    },
    "TargetsFile": {
      "properties": {
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
