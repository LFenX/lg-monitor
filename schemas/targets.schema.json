{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/TargetsFile",
  "$defs": {
    "Duration": {
      "type": "string",
      "pattern": "^\\+?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h|d))+)$"
    },
    "EventLogSubscription": {
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "Application",
            "System"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "levels": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "channel",
        "provider"
      ]
    },
    "Match": {
      "allOf": [
        {
          "if": {
            "required": [
              "workDir"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "process"
                ]
              },
              {
                "required": [
                  "cmdline"
                ]
              },
              {
                "required": [
                  "exeDir"
                ]
              }
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "process"
          ]
        },
        {
          "required": [
            "cmdline"
          ]
        },
        {
          "required": [
            "port"
          ]
        },
        {
          "required": [
            "service"
          ]
        },
        {
          "required": [
            "exeDir"
          ]
        },
        {
          "required": [
            "workDir"
          ]
        }
      ],
      "properties": {
        "process": {
          "type": "string",
          "minLength": 1
        },
        "cmdline": {
          "type": "string",
          "minLength": 1,
          "description": "命令行正则默认不区分大小写；可用 (?-i) 显式区分大小写。"
        },
        "exeDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]{2}[^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+[\\\\/][^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+(?:[\\\\/]|$))[^:*?\"\u003c\u003e|\\x00-\\x1f]*$",
          "description": "程序所在目录，Windows 绝对盘符或 UNC 路径；匹配自身及子目录，不区分大小写。"
        },
        "workDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z]:[\\\\/]|[\\\\/]{2}[^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+[\\\\/][^\\\\/:*?\"\u003c\u003e|\\x00-\\x1f]+(?:[\\\\/]|$))[^:*?\"\u003c\u003e|\\x00-\\x1f]*$",
          "description": "当前工作目录，需同时配置 process、cmdline 或 exeDir；只对候选读取，十秒内复用缓存。"
        },
        "port": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Probe": {
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tcp"
              }
            }
          },
          "then": {
            "required": [
              "address"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ]
          }
        },
        {
          "if": {
            "required": [
              "keywordAbsent"
            ]
          },
          "then": {
            "required": [
              "keyword"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "http"
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "keyword"
                  ]
                },
                {
                  "required": [
                    "keywordAbsent"
                  ]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "http",
            "tcp",
            "script"
          ]
        },
        "script": {
          "not": {
            "pattern": "[.][.]"
          },
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:\u003c\u003e\"|?*%\u0026^!()\\x00-\\x1F\\x7F]+\\.(?:[pP][sS]1|[cC][mM][dD]|[bB][aA][tT]|[eE][xX][eE])$"
        },
        "args": {
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 _.,:=/@+-]*$"
          },
          "type": "array"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "$ref": "#/$defs/Duration"
        },
        "timeout": {
          "$ref": "#/$defs/Duration"
        },
        "expectStatus": {
          "$ref": "#/$defs/Status"
        },
        "keyword": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "description": "区分大小写的 UTF-8 子串，1～256 字节；只检查解压正文的前 1 MiB。",
          "x-maxUtf8Bytes": 256
        },
        "keywordAbsent": {
          "type": "boolean",
          "description": "为 true 时要求关键字不出现；必须同时配置 keyword，仅限 HTTP。"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "interval",
        "timeout"
      ]
    },
    "Status": {
      "oneOf": [
        {
          "type": "integer",
          "maximum": 599,
          "minimum": 100
        },
        {
          "type": "string",
          "pattern": "^([1-5][0-9]{2}|[1-5]xx|[\u003c\u003e]=?[1-5][0-9]{2})$"
        }
      ]
    },
    "Target": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "collector": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^(\\*|[^\\s*/\\\\:]+)$",
          "description": "采集器 ID 或主机名；* 或省略表示全部采集器，主机名不区分大小写。"
        },
        "match": {
          "$ref": "#/$defs/Match"
        },
        "eventlog": {
          "$ref": "#/$defs/EventLogSubscription"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/Probe"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id"
      ]
    },
    "TargetsFile": {
      "properties": {
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}
